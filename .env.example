# Copy this file to .env and set values from your Mercado Pago test application.
MP_ACCESS_TOKEN=

# Flat BRL shipping amount configured by the store (for example: 18.90).
# The payment endpoint stays disabled until this is set.
SHIPPING_COST_BRL=

# Optional public HTTPS URL for payment return links. Localhost is not accepted by Mercado Pago.
APP_BASE_URL=

PORT=4173
SHIPPING_COST_BRL